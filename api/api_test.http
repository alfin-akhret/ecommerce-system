@baseUrl = http://localhost:8080

### Health
GET {{baseUrl}}/health

### Create user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "NewUser2",
  "email": "newUser2@gmail.com",
  "password": "ChangeMe123!"
}

### Get user (not found)
GET {{baseUrl}}/users/<USER_ID>

### Get user (found)
GET {{baseUrl}}/users/<USER_ID>

### Register
POST {{baseUrl}}/register
Content-Type: application/json

{
  "name": "NewUser4",
  "email": "newUser4@gmail.com",
  "password": "ChangeMe1234!"
}

### Login (success)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "newUser4@gmail.com",
  "password": "ChangeMe1234!"
}

### Login (invalid credentials)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "newUser4@gmail.com",
  "password": "wrong-password"
}

### Me (replace <TOKEN> with login token)
GET {{baseUrl}}/me
Authorization: Bearer <TOKEN>

### Create product (replace <TOKEN> with login token)
POST {{baseUrl}}/products
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
  "name": "T-Shirt",
  "description": "Cotton tee",
  "price": 19.99,
  "stock": 50
}

### PRODUCT
@productID = 0c8eb080-8e13-4ffc-893a-597f8c7ade70
### List products
GET {{baseUrl}}/products

### Get product by ID (replace <PRODUCT_ID> with actual product ID)
GET {{baseUrl}}/products/{{productID}}

### update product stock (replace <PRODUCT_ID> with actual product ID)
PATCH {{baseUrl}}/products/{{productID}}/stock
Content-Type: application/json

{
  "qty": 5
}

### reserve stock
POST {{baseUrl}}/products/{{productID}}/reserve
Content-Type: application/json

{
  "qty": 2
}

### reserve stock (oversell)
POST {{baseUrl}}/products/{{productID}}/reserve
Content-Type: application/json

{
  "qty": 100
}
